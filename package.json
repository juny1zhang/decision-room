{
  "name": "decision-room",
  "version": "1.1.0",
  "private": true,
  "description": "A local discussion room for Codex, Claude Code and Cursor Agent",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/juny1zhang/decision-room.git"
  },
  "bugs": {
    "url": "https://github.com/juny1zhang/decision-room/issues"
  },
  "type": "module",
  "bin": {
    "decision-room": "server.mjs"
  },
  "files": [
    "server.mjs",
    "src/",
    "public/",
    "README*",
    "LICENSE",
    "CHANGELOG.md",
    "Start-Decision-Room.command"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node server.mjs",
    "check": "node server.mjs --check",
    "test": "node --test \"tests/unit/**/*.test.mjs\" \"tests/integration/**/*.test.mjs\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "playwright": "1.63.0",
    "prettier": "3.10.0"
  }
}
